<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>
<div class="row mt-3">
    <div class="col-8 offset-3">
        <h2><%= listing.title %></h2>
    </div>

    <div class="card col-6 offset-3">
        <img src="<%= listing.image.url %>" class="card-img-top show-image" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                Owner: <b><i><%= listing.owner.username %></i></b><br>
                <%= listing.description %><br>
                &#8377;<%= listing.price.toLocaleString("en-IN") %><br>
                <%= listing.location %><br>
                <%= listing.country %><br>
            </p>
        </div>
    </div>

    <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns col-6 offset-3 mt-3">
            <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark">Edit</a>
            <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
                <br>
                <button class="btn btn-dark" type="submit">DELETE</button>
            </form>
        </div>
    <% } %>

    <div class="col-8 offset-3">
        <hr>

        <% if (currUser) { %>
            <h3>Leave a Review</h3>
            <form method="post" action="/listings/<%= listing.id %>/reviews" class="needs-validation" novalidate>
                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <fieldset class="starability-heart">
    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />

    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
    <label for="first-rate5" title="Amazing">5 stars</label>

    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
    <label for="first-rate4" title="Very good">4 stars</label>

    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
    <label for="first-rate3" title="Average">3 stars</label>

    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
    <label for="first-rate2" title="Not good">2 stars</label>

    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
    <label for="first-rate1" title="Terrible">1 star</label>
</fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" cols="90" rows="5" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add a comment for Review.</div>
                </div>
                <button class="btn btn-dark">Submit</button>
            </form>
        <% } %>

       <%if(listing.reviews.length>0){%>
        <div class="row">
             <h4 class="mt-4">All Reviews</h4>
            <% for (const review of listing.reviews) { %>
                <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                        <h4 class="card-title">@<%= review.author.username %></h4>
                        <p class="card-text"><i><%= review.comment %></i></p>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>">
                        </p>
                    </div>
                    <% if (currUser && currUser._id.equals(review.author._id)) { %>
                        <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark mb-2">DELETE</button>
                        </form>
                    <% } %>
                </div>
            <% } %>
        </div>
    <%}%>
       
    </div>
     <DIV class="col-8 offset-3 mb-3">
            <h3>Where You'll Be</h3>
            <div id="map"></div>
            

        </DIV>
</div>
<script src="/js/map.js"></script>